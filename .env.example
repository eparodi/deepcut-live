# DeepCut Live — Environment Variables
# Copy this to .env and fill in your values

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
# Set authorized redirect URI to: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# These have defaults in docker-compose.yml — change for production
# Generate with: openssl ecparam -genkey -name prime256v1 -noout -out private.pem
#                openssl ec -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
SRS_CALLBACK_SECRET=dev-srs-secret
